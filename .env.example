NODE_ENV=development
PORT=3002
HOST=127.0.0.1
DATABASE_PATH=./data/kidview.sqlite
# Required in production. Generate a unique random value of at least 32 characters.
SESSION_SECRET=dev-only-change-me
SESSION_COOKIE_NAME=kidview.sid
# Required in production and must use https (for example, https://kidview.example.com).
APP_ORIGIN=
# Set only when a known reverse proxy terminates HTTPS (for example, loopback).
TRUST_PROXY=
SEED_PARENT_EMAIL=parent@example.com
SEED_PARENT_PASSWORD=password123
VIDEO_SOURCE=mock
YOUTUBE_API_KEY=
YOUTUBE_MAX_SEARCH_RESULTS=10
YOUTUBE_MAX_CANDIDATES_PER_SEARCH=40
YOUTUBE_REQUEST_TIMEOUT_MS=10000
YOUTUBE_SAFE_SEARCH=moderate
YOUTUBE_REGION_CODE=US
YOUTUBE_RELEVANCE_LANGUAGE=en
USAGE_TIME_ZONE=America/Chicago
