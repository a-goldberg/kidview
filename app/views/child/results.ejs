<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main class="page">
  <section class="page-heading">
    <p class="eyebrow">Search results</p>
    <h1><%= query ? query : 'Search' %></h1>
    <p class="muted">KidView shows up to three choices at a time.</p>
  </section>

  <% if (!query) { %>
    <section class="panel">
      <p>Start with a search term.</p>
      <a class="secondary-button" href="/child/search">Go to search</a>
    </section>
  <% } else if (!results.length) { %>
    <section class="panel">
      <h2>No ready videos yet</h2>
      <p class="muted">Try another search idea, or ask a parent to review more videos.</p>
      <div class="suggestion-list" aria-label="Search ideas">
        <% suggestions.forEach((suggestion) => { %>
          <a href="/child/results?q=<%= encodeURIComponent(suggestion) %>"><%= suggestion %></a>
        <% }) %>
      </div>
      <a class="secondary-button" href="/child/search?q=<%= encodeURIComponent(query) %>">Search again</a>
    </section>
  <% } else { %>
    <section class="result-grid" aria-label="Video results">
      <% results.forEach((result) => { %>
        <article class="video-card">
          <div class="video-icon">
            <img src="<%= result.iconPath %>" alt="" aria-hidden="true">
          </div>
          <div class="video-card-body">
            <p class="category"><%= result.primaryCategory %> · <%= Math.round(result.durationSeconds / 60) %> min</p>
            <h2><%= result.title %></h2>
            <p><%= result.childExplanation %></p>
            <p class="channel"><%= result.channelTitle %></p>
            <a class="secondary-button" href="<%= result.watchUrl %>">Open</a>
          </div>
        </article>
      <% }) %>
    </section>

    <div class="center-action action-row">
      <% if (searchEventId) { %>
        <form action="/child/search-events/<%= searchEventId %>/not-what-i-meant" method="post">
          <input type="hidden" name="query" value="<%= query %>">
          <button class="secondary-button" type="submit">Not what I meant</button>
        </form>
      <% } %>
      <a class="secondary-button" href="/child/search?q=<%= encodeURIComponent(query) %>">New search</a>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
