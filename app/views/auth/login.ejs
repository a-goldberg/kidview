<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main class="page narrow-page">
  <section class="panel">
    <p class="eyebrow">Parent area</p>
    <h1>Log in</h1>
    <p class="muted"><%= returnTo ? 'Log in to choose who will use KidView on this device.' : 'Use the seeded parent account to view household controls.' %></p>

    <% if (error) { %>
      <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <form class="stacked-form" action="/auth/login" method="post">
      <% if (returnTo) { %><input type="hidden" name="returnTo" value="<%= returnTo %>"><% } %>
      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" value="<%= email %>" required>
      </label>

      <label>
        <span>Password</span>
        <input name="password" type="password" autocomplete="current-password" required>
      </label>

      <button class="primary-button" type="submit">Log in</button>
    </form>
  </section>
</main>

<%- include('../partials/footer') %>
