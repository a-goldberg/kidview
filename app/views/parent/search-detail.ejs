<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main class="page parent-page">
  <section class="page-heading compact-heading">
    <p class="eyebrow">Parent audit</p>
    <h1>Search details</h1>
    <p class="muted"><strong>"<%= audit.event.query %>"</strong> · <%= audit.event.created_at %></p>
  </section>

  <%- include('dashboard-nav', { activeSection: 'searches' }) %>

  <div class="dashboard-back-row">
    <a class="secondary-button small-button" href="/parent/searches">Back to search audit</a>
    <a class="secondary-button small-button" href="/parent">Dashboard overview</a>
  </div>

  <section class="dashboard-grid dashboard-4-col" aria-label="Search summary">
    <article class="panel">
      <h2>Source</h2>
      <p class="muted"><%= displayLabel('sourceMode', audit.event.source_mode, displayLocale) %></p>
    </article>
    <article class="panel">
      <h2>Child profile</h2>
      <p class="muted"><%= audit.event.child_profile_name || 'No child profile' %></p>
    </article>
    <article class="panel">
      <h2>Shown</h2>
      <p class="muted"><%= audit.event.shown_to_child_count %> of <%= audit.event.source_candidate_count %></p>
    </article>
    <article class="panel">
      <h2>Review</h2>
      <p class="muted"><%= audit.event.sent_to_review_count %> sent to review</p>
    </article>
  </section>

  <section class="decision-history search-detail-list">
    <% if (audit.candidates.length) { %>
      <% audit.groups.forEach((group) => { %>
        <div class="decision-section">
          <h2><%= group.title %> <span class="count-pill"><%= group.candidates.length %></span></h2>
          <% if (!group.candidates.length) { %>
            <article class="panel">
              <p class="muted">No candidates in this group.</p>
            </article>
          <% } %>

          <% group.candidates.forEach((candidate) => { %>
            <article class="history-row search-audit-row">
              <div class="history-main">
                <p class="category">
                  #<%= candidate.source_rank || '?' %> · <%= displayLabel('finalDecision', candidate.final_decision, displayLocale) %> · <%= candidate.shown_to_child ? 'Shown' : 'Hidden' %>
                </p>
                <h3><%= candidate.title %></h3>
                <p class="muted">
                  <%= candidate.channel_title || 'Unknown channel' %>
                  <% if (candidate.primary_category || candidate.duration_seconds) { %>
                    · <%= candidate.primary_category || 'General' %>
                    <% if (candidate.duration_seconds) { %>
                      · <%= Math.max(1, Math.round(candidate.duration_seconds / 60)) %> min
                    <% } %>
                  <% } %>
                </p>
                <p class="review-reason compact-note"><%= candidate.visibility_reason %></p>
                <% if (candidate.hard_block_reason) { %>
                  <p class="muted"><strong>Hard block:</strong> <%= candidate.hard_block_reason %></p>
                <% } %>
                <% if (candidate.parent_decision_affected) { %>
                  <p class="muted"><strong>Parent decision involved:</strong> <%= displayLabel('parentDecisionSource', candidate.parent_decision_source || 'household', displayLocale) %></p>
                <% } %>
                <% if (candidate.content_tags.length || candidate.quality_tags.length || candidate.risk_tags.length) { %>
                  <ul class="label-list compact-labels">
                    <% candidate.content_tags.forEach((tag) => { %>
                      <li class="content-tags"><%= displayLabel('contentTag', tag, displayLocale) %></li>
                    <% }) %>
                    <% candidate.quality_tags.forEach((tag) => { %>
                      <li><%= displayLabel('qualityTag', tag, displayLocale) %></li>
                    <% }) %>
                    <% candidate.risk_tags.forEach((tag) => { %>
                      <li class="risk-tags"><%= displayLabel('riskTag', tag, displayLocale) %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
              <div class="search-audit-metrics">
                <p><strong>Source:</strong> <%= displayLabel('moderationSource', candidate.moderation_source || 'unknown', displayLocale) %></p>
                <p><strong>Parent Override:</strong> <%= candidate.parent_decision_affected ? 'Yes' : 'No' %></p>
                <% if (candidate.visibility_reason_code) { %>
                  <p><strong>Audit Reason:</strong> <%= displayLabel('visibilityReasonCode', candidate.visibility_reason_code, displayLocale) %></p>
                <% } %>
                <p><strong>Review Queue:</strong> <%= displayLabel('reviewQueueState', candidate.review_queue_state || 'none', displayLocale) %></p>
                <% if (candidate.review_queue_reason_code) { %>
                  <p><strong>Queue Reason:</strong> <%= displayLabel('reviewQueueReasonCode', candidate.review_queue_reason_code, displayLocale) %></p>
                <% } %>
                <div class="button-row">
                  <% if (candidate.review_link && (candidate.review_queue_state === 'created_pending' || candidate.review_queue_state === 'matched_pending')) { %>
                    <a class="secondary-button small-button" href="<%= candidate.review_link %>">Review item</a>
                  <% } %>
                  <% if (candidate.decision_link) { %>
                    <a class="secondary-button small-button" href="<%= candidate.decision_link %>">Decision history</a>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% }) %>
    <% } else { %>
      <article class="panel">
        <p class="muted">No candidate audit rows were saved for this search.</p>
      </article>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>
