<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main class="page parent-page">
  <section class="page-heading compact-heading">
    <p class="eyebrow">Parent dashboard</p>
    <h1><%= dashboard.household.name %></h1>
    <p class="muted">One workspace for review decisions, search audit, child profiles, and policy settings.</p>
  </section>

  <%- include('dashboard-nav', { activeSection: 'overview' }) %>

  <section class="dashboard-grid dashboard-2-col parent-overview-grid" aria-label="Dashboard summary">
    <article class="panel dashboard-summary-card">
      <p class="category">Needs attention</p>
      <h2 class="<%= dashboard.pendingReviewCount > 0 ? 'accent' : '' %>"><%= dashboard.pendingReviewCount %> pending video<%= dashboard.pendingReviewCount === 1 ? '' : 's' %></h2>
      <p class="muted">Review parent-actionable videos before they can appear for children.</p>
      <% if (dashboard.pendingReviewCount > 0 ) { %>
        <a class="secondary-button small-button" href="/parent/reviews">Open review queue</a>
      <% } %>
    </article>

    <article class="panel">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Recent searches</p>
        </div>
        <a class="secondary-button small-button" href="/parent/searches">View all</a>
      </div>
      <% if (dashboard.recentSearches.length) { %>
        <ul class="simple-list" id="parent-recent-searches">
          <% dashboard.recentSearches.forEach((event) => { %>
            <li>
              <strong><%= event.query %></strong>
              <span><%= event.result_count %> result(s)</span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="muted">No searches have been logged yet.</p>
      <% } %>
    </article>

  </section>

  <section class="dashboard-workspace-grid" aria-label="Parent dashboard details">
    <article class="panel child-profile-selector" id="child-profiles">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Child profiles</p>
          <h2>Select the active child profile for this device.</h2>
        </div>
        <span class="count-pill"><%= dashboard.children.length %></span>
      </div>
      <p class="muted">Choosing a profile starts child mode on this device and signs out of parent controls.</p>
      <% if (dashboard.children.length) { %>
        <ul class="profile-selector-list">
          <% dashboard.children.forEach((child) => { %>
            <% const isActive = activeChildProfile && activeChildProfile.id === child.id; %>
            <li class="profile-selector-card<%= isActive ? ' is-active' : '' %>">
              <div class="profile-selector-heading">
                <div>
                  <h3><%= child.display_name %></h3>
                  <p class="muted"><%= child.policy_profile_name || 'Default result policy' %></p>
                </div>
                <% if (isActive) { %><span class="active-profile-badge">Active on this device</span><% } %>
              </div>
              <dl class="profile-summary-list">
                <div>
                  <dt>Limited-access policy</dt>
                  <dd><%= displayLabel('allowLimitedPolicy', child.allow_limited_policy || 'block', displayLocale) %></dd>
                </div>
                <div>
                  <dt>Daily search limit</dt>
                  <dd><%= child.daily_search_limit === null ? 'No limit' : `${child.daily_search_limit} searches` %></dd>
                </div>
                <div>
                  <dt>Daily watch limit</dt>
                  <dd><%= child.daily_video_watch_limit === null ? 'No limit' : `${child.daily_video_watch_limit} videos` %></dd>
                </div>
              </dl>
              <form action="/child/profile/<%= child.id %>/activate" method="post">
                <button class="secondary-button small-button" type="submit"><%= isActive ? 'Search with this profile again' : `Search as ${child.display_name}` %></button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="muted">No child profiles yet. Create one before setting up this device.</p>
      <% } %>
      <a class="primary-button small-button" href="/parent/profiles">Manage child profiles</a>
    </article>

    
  </section>
</main>

<%- include('../partials/footer') %>
