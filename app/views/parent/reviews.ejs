<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main class="page parent-page">
  <section class="page-heading compact-heading">
    <p class="eyebrow">Parent reviews</p>
    <h1>Review videos</h1>
    <p class="muted">Parent-facing reasons stay here and are never shown in the child UI.</p>
  </section>

  <%- include('dashboard-nav', { activeSection: 'reviews' }) %>

  <form class="filter-bar review-filter-bar" action="/parent/reviews" method="get">
    <label>
      <span>Search queue</span>
      <input name="search" value="<%= reviewQueue.filters.search %>" placeholder="Title, channel, label, reason">
    </label>
    <label>
      <span>Status</span>
      <select name="status">
        <option value="all" <%= reviewQueue.filters.status === 'all' ? 'selected' : '' %>>All review items</option>
        <option value="review" <%= reviewQueue.filters.status === 'review' ? 'selected' : '' %>>Review</option>
        <option value="unknown" <%= reviewQueue.filters.status === 'unknown' ? 'selected' : '' %>>Unknown</option>
        <option value="allow_limited" <%= reviewQueue.filters.status === 'allow_limited' ? 'selected' : '' %>>Allow limited</option>
      </select>
    </label>
    <label>
      <span>Sort</span>
      <select name="sort">
        <option value="status" <%= reviewQueue.filters.sort === 'status' ? 'selected' : '' %>>Status priority</option>
        <option value="date_newest" <%= reviewQueue.filters.sort === 'date_newest' ? 'selected' : '' %>>Date added, newest</option>
        <option value="date_oldest" <%= reviewQueue.filters.sort === 'date_oldest' ? 'selected' : '' %>>Date added, oldest</option>
        <option value="requests" <%= reviewQueue.filters.sort === 'requests' ? 'selected' : '' %>>Most requested</option>
        <option value="confidence_low" <%= reviewQueue.filters.sort === 'confidence_low' ? 'selected' : '' %>>Lowest confidence</option>
        <option value="risk" <%= reviewQueue.filters.sort === 'risk' ? 'selected' : '' %>>Most risk tags</option>
      </select>
    </label>
    <button class="secondary-button small-button" type="submit">Filter</button>
  </form>

  <% if (reviewQueue.bulkMessage) { %>
    <p class="decision-status" data-state="saved"><%= reviewQueue.bulkMessage %></p>
  <% } %>

  <form class="bulk-action-bar" action="/parent/reviews/bulk" method="post">
    <input type="hidden" name="search" value="<%= reviewQueue.filters.search %>">
    <input type="hidden" name="status" value="<%= reviewQueue.filters.status %>">
    <input type="hidden" name="sort" value="<%= reviewQueue.filters.sort %>">
    <span><strong><%= reviewQueue.videos.length %></strong> visible videos</span>
    <button class="primary-button small-button" type="submit" name="action" value="approve_all">Approve all</button>
    <button class="danger-button small-button" type="submit" name="action" value="block_all">Block all</button>
    <button class="secondary-button small-button" type="submit" name="action" value="delete_all" data-confirm="This removes pending items from your review queue. It does not delete videos, channels, search history, or parent decisions. If the child searches for the same video again, it may return to the queue.">Clear queue</button>
  </form>

  <section class="review-layout">
    <div class="review-list">
      <h2>Videos <span class="count-pill"><%= reviewQueue.videos.length %></span></h2>
      <% if (!reviewQueue.videos.length) { %>
        <article class="panel">
          <p class="muted">No videos need review.</p>
        </article>
      <% } %>

      <% reviewQueue.videos.forEach((video) => { %>
        <article class="review-card" id="video-<%= video.id %>" data-decision-card>
          <div>
            <p class="category"><%= video.primary_category %> · <%= Math.round(video.duration_seconds / 60) %> min · <%= displayLabel('finalDecision', video.queue_status, displayLocale) %></p>
            <h3><%= video.title %></h3>
            <p class="muted"><%= video.channel_title %></p>
            <ul class="label-list">
              <% video.labels.forEach((label) => { %>
                <li><%= label %></li>
              <% }) %>
              <% if (video.is_short) { %><li>Short</li><% } %>
              <% if (video.live_status === 'live') { %><li>Live now</li><% } %>
              <% if (video.live_status === 'upcoming') { %><li>Upcoming live</li><% } %>
              <% if (video.live_status === 'completed_live') { %><li><%= displayLabel('liveStatus', video.live_status, displayLocale) %></li><% } %>
            </ul>
            <% if (video.channel_decision) { %>
              <p class="muted">Channel decision: <strong><%= displayLabel('channelDecision', video.channel_decision, displayLocale) %></strong></p>
            <% } %>
            <details class="info-disclosure">
              <summary>Details</summary>
              <p><%= video.description %></p>
              <p class="muted">Rule confidence: <strong><%= Math.round((video.review_confidence_score || video.confidence_score || 0) * 100) %>%</strong></p>
              <p class="muted">Views: <strong><%= Number(video.view_count || 0).toLocaleString() %></strong></p>
              <p class="review-reason"><strong>Moderation explanation:</strong> <%= video.moderation_explanation || video.review_reason || video.parent_explanation || 'No moderation explanation available.' %></p>
              <% if (video.content_tags.length || video.quality_tags.length || video.risk_tags.length) { %>
                <ul class="label-list">
                  <% video.content_tags.forEach((tag) => { %>
                    <li class="content-tags"><%= displayLabel('contentTag', tag, displayLocale) %></li>
                  <% }) %>
                  <% video.quality_tags.forEach((tag) => { %>
                    <li class="quality-tags"><%= displayLabel('qualityTag', tag, displayLocale) %></li>
                  <% }) %>
                  <% video.risk_tags.forEach((tag) => { %>
                    <li class="risk-tags"><%= displayLabel('riskTag', tag, displayLocale) %></li>
                  <% }) %>
                </ul>
              <% } %>
            </details>
          </div>

          <form class="decision-form review-decision-form" action="/parent/reviews/videos/<%= video.id %>/decision" method="post" data-async-decision data-remove-on-success="true">
            <label>
              <span>Parent note</span>
              <input name="reason" value="<%= video.video_decision_reason || '' %>" placeholder="Optional note for this household decision">
            </label>
            <div class="button-row">
              <button class="primary-button" type="submit" name="decision" value="allow">Allow video</button>
              <button class="danger-button" type="submit" name="decision" value="block">Block video</button>
            </div>
            <div class="button-row">
              <button class="secondary-button" type="submit" name="decision" value="allow_limited">Allow limited</button>
              <button class="secondary-button" type="submit" name="decision" value="review_required">Review required</button>
              <button class="secondary-button" type="submit" formaction="/parent/reviews/videos/<%= video.id %>/ignore" data-confirm="Ignore removes this item from the review queue without allowing or blocking the video. If it appears in a future search, it may return to review.">Ignore</button>
            </div>
            <p class="decision-status" role="status"></p>
          </form>
        </article>
      <% }) %>
    </div>

    <aside class="panel">
      <h2>Channels <span class="count-pill"><%= reviewQueue.channels.length %></span></h2>
      <p class="muted">A channel decision applies to future videos unless a video-specific decision overrides it.</p>
      <% const unreviewedChannelCount = reviewQueue.channels.filter((channel) => !channel.decision).length; %>
      <form class="channel-cleanup-form" action="/parent/reviews/bulk" method="post">
        <input type="hidden" name="search" value="<%= reviewQueue.filters.search %>">
        <input type="hidden" name="status" value="<%= reviewQueue.filters.status %>">
        <input type="hidden" name="sort" value="<%= reviewQueue.filters.sort %>">
        <span><strong><%= unreviewedChannelCount %></strong> unreviewed</span>
        <button class="secondary-button small-button" type="submit" name="action" value="delete_channels" data-confirm="This clears pending review videos for visible unreviewed channels. It does not delete videos, channels, search history, or parent decisions. If the child searches again, items may return to the queue." <%= unreviewedChannelCount ? '' : 'disabled' %>>Clear unreviewed channels</button>
      </form>
      <div class="channel-decision-list">
        <% reviewQueue.channels.forEach((channel) => { %>
          <form class="channel-form" action="/parent/reviews/channels/<%= channel.id %>/decision" method="post" data-async-decision>
            <strong><%= channel.title %></strong>
            <span class="muted"><%= channel.pending_video_count %> pending video<%= channel.pending_video_count === 1 ? '' : 's' %></span>
            <span class="muted">Current: <strong data-decision-current><%= displayLabel('channelDecision', channel.decision || 'none', displayLocale) %></strong></span>
            <input name="reason" placeholder="Parent note" value="<%= channel.parent_facing_reason || '' %>">
            <div class="button-row">
              <button class="primary-button" type="submit" name="decision" value="approved">Approve</button>
              <button class="danger-button" type="submit" name="decision" value="blocked">Block</button>
              <button class="secondary-button" type="submit" name="decision" value="review_first">Review first</button>
            </div>
            <p class="decision-status" role="status"></p>
          </form>
        <% }) %>
      </div>
    </aside>
  </section>
</main>

<%- include('../partials/footer') %>
