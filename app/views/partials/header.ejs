    <header class="site-header">
      <a class="brand" href="/child/search" aria-label="KidView home">
        <span class="brand-mark">KV</span>
        <span>KidView</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/child/search">Child Search</a>
        <a href="/parent">Parent Dashboard</a>
        <% if (currentParent) { %>
          <form action="/auth/logout" method="post">
            <button class="link-button" type="submit">Log Out</button>
          </form>
        <% } else { %>
          <a href="/auth/login">Log In</a>
        <% } %>
      </nav>
    </header>

    <% if (typeof isDemo !== 'undefined' && isDemo) { %>
      <section class="panel" data-demo-mode aria-label="Demo information">
        <strong>Read-only demo</strong>
        <p>This household contains synthetic sample data.  Changes and live API calls are disabled.  Child searches open a fixed sample result, and sample videos do not play.</p>
      </section>
    <% } %>
